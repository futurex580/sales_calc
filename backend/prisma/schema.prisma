generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  SALES_REP
}

enum TierBasis {
  QUANTITY
  REVENUE
}

enum RewardType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CalculationMethod {
  INCREMENTAL
  RETROACTIVE
}

model Company {
  id                String               @id @default(uuid())
  name              String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  users             User[]
  products          Product[]
  salesRecords      SalesRecord[]
  incentivePrograms IncentiveProgram[]
  commissionTiers   CommissionRuleTier[]
  auditLogs         AuditLog[]
  commissionRecords CommissionRecord[]
}

model User {
  id                String        @id @default(uuid())
  companyId         String
  role              Role
  email             String        @unique
  passwordHash      String
  name              String

  // APP-LEVEL ENCRYPTION (AES-256) REQUIRED FOR UU PDP COMPLIANCE BEFORE DB INSERT
  ktp               String?       // National ID
  bankAccount       String?       // Bank details for commission payout

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company           Company       @relation(fields: [companyId], references: [id])
  salesRecords      SalesRecord[]
  auditLogs         AuditLog[]

  @@index([companyId])
}

model Product {
  id                String               @id @default(uuid())
  companyId         String
  name              String
  cogs              Decimal              @db.Decimal(10, 2) // Cost of Goods Sold
  basePrice         Decimal              @db.Decimal(10, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  company           Company              @relation(fields: [companyId], references: [id])
  salesRecords      SalesRecord[]
  incentivePrograms IncentiveProgram[]   // Many-to-many: Product belongs to many programs

  @@index([companyId])
}

model SalesRecord {
  id                String        @id @default(uuid())
  companyId         String
  userId            String
  productId         String
  quantity          Int
  totalValue        Decimal       @db.Decimal(15, 2)
  soldAt            DateTime      @default(now())

  company           Company       @relation(fields: [companyId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  product           Product       @relation(fields: [productId], references: [id])
  commissionRecords CommissionRecord[] // 1-to-Many: 1 Sale can trigger multiple payouts!

  @@index([companyId])
  @@index([userId])
}

model IncentiveProgram {
  id                String               @id @default(uuid())
  companyId         String
  name              String
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean              @default(false)
  calculationMethod CalculationMethod    @default(INCREMENTAL)
  createdAt         DateTime             @default(now())

  company           Company              @relation(fields: [companyId], references: [id])
  tiers             CommissionRuleTier[]
  products          Product[]            // Many-to-many: Program covers many products. If empty = ALL Products

  @@index([companyId])
}

model CommissionRuleTier {
  id                 String           @id @default(uuid())
  companyId          String
  incentiveProgramId String
  minTarget          Decimal          @db.Decimal(15, 2) // Replaces minQuantity, can be QTY or $
  maxTarget          Decimal?         @db.Decimal(15, 2) // Replaces maxQuantity, can be QTY or $
  tierBasis          TierBasis        @default(QUANTITY) // Count by pieces or revenue?
  rewardType         RewardType       @default(PERCENTAGE) // Pay in % or fixed $?
  rewardValue        Decimal          @db.Decimal(15, 2) // E.g., 5 (%) or 50 ($)

  company            Company          @relation(fields: [companyId], references: [id])
  incentiveProgram   IncentiveProgram @relation(fields: [incentiveProgramId], references: [id])
  commissionRecords  CommissionRecord[]

  @@index([companyId])
  @@index([incentiveProgramId])
}

model AuditLog {
  id                String        @id @default(uuid())
  companyId         String
  userId            String
  action            String        // e.g., "VIEW_DECRYPTED_KTP", "CREATE_INCENTIVE"
  entity            String        // e.g., "User", "IncentiveProgram"
  entityId          String
  details           Json?         // Stores previous state vs new state
  createdAt         DateTime      @default(now())

  company           Company       @relation(fields: [companyId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
}
model CommissionRecord {
  id                String             @id @default(uuid())
  companyId         String
  salesRecordId     String             // Removed @unique so multiple records can point to 1 sale
  tierId            String?            
  rewardApplied     Decimal            @db.Decimal(15, 2) // Record what the reward was at the time
  rewardType        RewardType         @default(PERCENTAGE)
  commissionEarned  Decimal            @db.Decimal(15, 2) // The final calculated $ amount
  createdAt         DateTime           @default(now())

  // Relations (Make sure these match your existing model names!)
  company           Company            @relation(fields: [companyId], references: [id])
  salesRecord       SalesRecord        @relation(fields: [salesRecordId], references: [id])
  tier              CommissionRuleTier? @relation(fields: [tierId], references: [id])
}
